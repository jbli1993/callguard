    <!-- extra -->
    <string name="section_intro">Getting started</string>
    <string name="intro_step1">1. Grant call screening just below — otherwise nothing is blocked.</string>
    <string name="intro_step2">2. Not using this project\'s dialer? Turn on the overlay — the system call banner takes the heads-up slot, so a normal notification waits in the shade.</string>
    <string name="intro_step3">3. To see online marks (spam/scam), turn on online lookup below — so are the regions to block.</string>
    <string name="intro_ok">Got it</string>
    <string name="section_reminder">How labels are shown</string>
    <string name="reminder_hint">If you use this project\'s dialer (it has its own call UI), leave the last two off — location and labels are drawn on its call screen. The system dialer needs one of them. In manual query mode the notification/overlay carries a “Look up” button.</string>
    <string name="section_extra">Extra rules</string>
    <string name="extra_virtual_title">Block virtual operators</string>
    <string name="extra_virtual_sub">162 / 165 / 167 / 170 / 171 etc.</string>
    <string name="extra_intl_title">Block international calls</string>
    <string name="extra_intl_sub">Outside +86</string>
    <string name="extra_unknown_title">Block unknown prefixes</string>
    <string name="extra_unknown_sub">New segments, landlines, hidden numbers</string>
    <string name="extra_contacts_title">Contacts whitelist</string>
    <string name="extra_contacts_sub">Numbers in your contacts skip every rule — international, unknown prefix, region, 700.</string>
    <string name="contacts_white_on">Granted · contacts are never blocked</string>
    <string name="contacts_white_off">No contacts permission — the whitelist is inactive</string>
    <string name="extra_relay_title">Silence 700 relay calls</string>
    <string name="extra_relay_sub">15-digit privacy numbers: courier, food delivery, ride-hailing</string>
    <string name="label_provider_title">Share labels with the dialer</string>
    <string name="label_provider_sub">A compatible dialer can show location and spam labels on its call screen. Only the number you pass in is used — never your contacts or call history.</string>

